# 飞书自建应用配置，仅用于 scripts/sync-feishu-doc.mjs，不要提交真实凭证
FEISHU_APP_ID=cli_xxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxx
# 可直接填写知识库空间链接；若空间下有多个文档，脚本会先列出文档清单
FEISHU_WIKI_URL=https://zanpw3z2hb6.feishu.cn/wiki/space/7666438057763015890
# 也可以填写某个具体文档节点链接：https://xxx.feishu.cn/wiki/<node_token>
# FEISHU_DOCUMENT_ID=具体文档ID
